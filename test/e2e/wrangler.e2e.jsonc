{
  // Local end-to-end runs only. Same Worker as ../../wrangler.jsonc, minus the Workers AI
  // binding, which always needs a live Cloudflare login.
  "name": "reel-eats-e2e",
  "main": "../../src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel-eats",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ]
}
