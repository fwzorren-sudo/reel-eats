{
  // Cloudflare Worker that serves the phone app and its API.
  // Setup steps are in README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reel-eats",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel-eats",
      // Created by `npx wrangler d1 create reel-eats`. Replace it if you deploy to a different account.
      "database_id": "4a98612a-9281-46bc-99a9-9af8aee08f45",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Workers AI reads captions. It comes with the Cloudflare account; no key needed.
  "ai": { "binding": "AI" },
  // Every minute: finish a share whose background job was cut short or handed over.
  // Daily at 08:17 UTC: re-check places with Google (closures, hours), check Apify credit.
  // If you change the daily time, change DAILY_CRON in src/upkeep.ts to match.
  "triggers": { "crons": ["* * * * *", "17 8 * * *"] },
  "vars": {
    // Workers AI model that reads captions, or "off" to use rules only.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Only used if you add an ANTHROPIC_API_KEY secret. Claude then replaces Workers AI.
    "CLAUDE_MODEL": "claude-opus-5",
    // low | medium | high. Lower is cheaper and faster.
    "CLAUDE_EFFORT": "medium",
    // "on" lets Claude run a few web searches when a caption only has an @handle or nickname.
    "CLAUDE_WEB_SEARCH": "on"
  },
  "observability": { "enabled": true }
}
