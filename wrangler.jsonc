{
  // Cloudflare Worker that serves the phone app and its API.
  // Setup steps are in README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reel-eats",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel-eats",
      // Paste the id printed by `npx wrangler d1 create reel-eats`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Claude model used to identify restaurants in a reel.
    "CLAUDE_MODEL": "claude-opus-5",
    // low | medium | high. Lower is cheaper and faster.
    "CLAUDE_EFFORT": "medium",
    // "on" lets Claude run a few web searches when a caption only has an @handle or nickname.
    "CLAUDE_WEB_SEARCH": "on"
  },
  "observability": { "enabled": true }
}
