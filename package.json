{
  "name": "reel-eats",
  "version": "1.0.0",
  "private": true,
  "description": "Save restaurants from Instagram reels to a personal map, keeping the branch closest to home.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply reel-eats --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply reel-eats --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^22.20.4",
    "leaflet": "^1.9.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.141.0"
  }
}
